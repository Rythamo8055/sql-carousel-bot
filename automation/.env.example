# ============================================================
# RYTHAMO INSTAGRAM AUTOMATION — KEYS
# Copy this file to ".env" and fill in the 4 values below.
# ============================================================

# 1. APP ID
# Where: developers.facebook.com -> My Apps -> YOUR APP -> Dashboard
# (left side card shows "App ID") — looks like: 1234567890123456
INSTAGRAM_APP_ID=your_app_id_here

# 2. APP SECRET
# Where: same app -> Settings -> Basic -> "App secret" -> click Show
# (you may need to enter your Meta password again)
# Looks like: a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6
INSTAGRAM_APP_SECRET=your_app_secret_here

# 3. ACCESS TOKEN (long-lived, 60 days)
# Where: developers.facebook.com/tools/explorer -> select YOUR APP ->
# "Generate Access Token" -> tick all permissions -> Copy token
# Then run: node exchange-token.js  (it converts it to a 60-day token)
# Looks like: EAAxxxx... (very long, ~200 chars)
INSTAGRAM_ACCESS_TOKEN=your_long_lived_token_here

# 4. INSTAGRAM BUSINESS ACCOUNT ID
# Where: run: node get-ids.js  (it prints it automatically)
# Looks like: 17841400000000000 (17 digits, starts with 17841)
INSTAGRAM_USER_ID=your_instagram_business_id_here